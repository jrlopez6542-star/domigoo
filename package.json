{
  "name": "domigoo",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "sh scripts/vercel-build.sh",
    "vercel-build": "sh scripts/vercel-build.sh",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "seed:simulacros": "pnpm --filter @domigoo/api seed:simulacros",
    "reset:simulacros": "pnpm --filter @domigoo/api reset:simulacros"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
