# Configuración de entorno STAGING AISLADO para DOMIGOO
# IMPORTANTE:
# - No almacenar secretos reales ni credenciales de producción en este archivo.
# - Copiar a `.env.staging` (ignorado por Git) y reemplazar los marcadores antes de ejecutar.
# - Todos los nombres de proyecto/BD usan el sufijo `-staging` para aislamiento total.

# Identificador explícito de entorno staging (obligatorio para ejecutar seed:staging)
DOMIGOO_ENV=staging

# Entorno de ejecución Node/API:
# - Para la API desplegada detrás de HTTPS (Vercel Preview/Staging) usar NODE_ENV=production.
# - Para ejecutar `seed:staging` desde terminal/CI usar NODE_ENV=development (seed:staging aborta si NODE_ENV=production).
NODE_ENV=development
APP_NAME=domigoo-staging
PORT=3001
STORAGE_DIR=/tmp/domigoo-staging-storage

# Base de datos PostgreSQL + PostGIS aislada para staging (host o BD debe contener "staging")
DATABASE_URL=postgresql://domigoo_staging:REEMPLAZAR_PASSWORD@ep-staging-pooler.example.neon.tech/domigoo-staging?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://domigoo_staging:REEMPLAZAR_PASSWORD@ep-staging.example.neon.tech/domigoo-staging?sslmode=require
# Opcional: lista separada por comas de hosts permitidos si el host/BD local no contiene "staging" (ej. 127.0.0.1)
STAGING_ALLOWED_DB_HOSTS=

# Claves criptográficas de staging (generar cada una con: openssl rand -base64 32)
PIN_PEPPER=REEMPLAZAR_CON_32_BYTES_EN_BASE64
APP_ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_EN_BASE64

# URLs de clientes (Web, Admin, Móvil) apuntando al backend de staging
API_BASE_URL=https://domigoo-staging.vercel.app
EXPO_PUBLIC_API_URL=https://domigoo-staging.vercel.app

# Smoke test contra API desplegada en staging (el host debe contener "staging", "preview", localhost o 127.0.0.1)
STAGING_API_URL=https://domigoo-staging.vercel.app
# Opcional: secreto de bypass si Vercel Authentication está activo en Preview/Staging
VERCEL_AUTOMATION_BYPASS_SECRET=
# Opcional: permitir explícitamente otro host en smoke-staging.mjs (STAGING_SMOKE_ALLOW_HOST=yes o lista en STAGING_ALLOWED_HOSTS)
STAGING_SMOKE_ALLOW_HOST=
STAGING_ALLOWED_HOSTS=

# Datos 100% ficticios para el seed idempotente de staging (sin PII real)
# OBLIGATORIO: definir manualmente una clave de 12 a 72 caracteres (sin valor por defecto en el repo)
STAGING_SEED_PASSWORD=REEMPLAZAR_CLAVE_STAGING_12_A_72_CHARS
STAGING_SEED_CONFIRM=yes
STAGING_ADMIN_EMAIL=reviewer-staging@example.com
STAGING_RESTAURANT_OWNER_EMAIL=restaurante-staging@example.com
STAGING_COURIER_EMAIL=domiciliario-staging@example.com
